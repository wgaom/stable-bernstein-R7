                    RowBox[{"{", RowBox[{"q", ",", "y", ",", "\[Lambda]"}], 
                      "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"same", "[", RowBox[{RowBox[{"poly0", "-", 
                    "sequential"}], ",", "\"Direct and sequential Schur \
