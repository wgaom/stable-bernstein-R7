                    " ", RowBox[{"(", RowBox[{"1", "-", "\[Delta]"}], 
                      ")"}]}], "-", FractionBox[RowBox[{"d", " ", 
                     SuperscriptBox["\[Delta]", "2"]}], "4"], "-", 
                  RowBox[{FractionBox["1", "2"], " ", "\[ScriptL]", " ", 
                    RowBox[{"(", RowBox[{"1", "-", "\[Delta]"}], ")"}]}]}]}], 
              ";", "\[IndentingNewLine]", "  ", RowBox[{"base", "=", 
                RowBox[{RowBox[{FractionBox["1", "2"], " ", "\[Sigma]", " ", 
