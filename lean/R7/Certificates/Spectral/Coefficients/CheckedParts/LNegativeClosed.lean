theorem order199 : R7.Core.SpectralCoefficient.Kronecker.ordered (R7.Core.SpectralCoefficient.Kronecker.packed base199 z199) = true := by decide +kernel

theorem bound199 : lhs199.bound + rhs199.bound < B199 := by decide +kernel

theorem point199 : lhs199.evaluateFast B199 = rhs199.evaluateFast B199 := by decide +kernel

theorem identity199 : interpretKey p199 = e199.denote := by
  exact R7.Core.SpectralCoefficient.Kronecker.identity_of_evaluation base199 degree199 denominator199
