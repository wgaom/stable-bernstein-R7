theorem binding199 : R7.Core.SpectralCoefficient.Kronecker.interpretKey z199 =
    MvPolynomial.C (denominator199 : ℚ) * interpretKey p199 :=
  R7.Core.SpectralCoefficient.Kronecker.scaledCoefficientsEqCross_sound denominator199 p199 coefficients199 (by decide +kernel)

theorem source_homogeneous199 : e199.denote.IsHomogeneous degree199 :=
