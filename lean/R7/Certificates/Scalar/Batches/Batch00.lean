theorem minor_bindings (i : Fin 4) :
    Univariate.equal (minorPolynomial numerator (i.val+1))
      (Univariate.scale (witness i).scale (witness i).polynomial) = true := by
  fin_cases i <;> decide +kernel
theorem numerator_length : numerator.length = 7 := by decide +kernel
theorem numerator_positive (x y : ℝ) (hy : 0 ≤ y) :
    0 < eval numerator x y := by
  have hd : ∀ k ≤ 3+1, 0 < Gram.delta
      (fun k => 2*evaluate (coefficient numerator (2*k)) y)
      (fun k => evaluate (coefficient numerator (2*k+1)) y) k := by
    intro k hk
    rcases k with _ | k
    · simp [Gram.delta]
    · have hk4 : k < 4 := by omega
      let kf : Fin 4 := ⟨k,hk4⟩
      have he := Univariate.equal_sound _ _ (minor_bindings kf) y
      rw [evaluate_minorPolynomial,evaluate_scale] at he
      rw [he]
      have hs : (0 : ℝ) < (witness kf).scale := by exact_mod_cast (witness kf).scale_pos
      exact mul_pos hs ((witness kf).positive y hy)
  rw [eval_eq_sum,numerator_length]
  exact Gram.power_polynomial_pos (fun k => evaluate (coefficient numerator k) y) 3 hd x

theorem transformed_lower (q y : ℝ) (hq : 0 ≤ q)
    (hqmax : q^2 ≤ 5/6) (hy : 0 ≤ y) :
    (lowerMargin : ℝ)*(1+y^2+y^4) ≤ R7.Core.scalarF parameters sigma q y := by
  apply scalarF_lower_of_chart_raw_nonneg_closed parameters side_conditions
    sigma q y lowerMargin hq hqmax hy
  intro x hx
  have he := source_identity x y
  have hl : 0 ≤ (j parameters y)^2*eval numerator x y :=
    mul_nonneg (sq_nonneg _) (le_of_lt (numerator_positive x y hy))
  rw [he] at hl
  exact nonneg_of_mul_nonneg_right hl (pow_pos (rationalDen_pos x) _)

theorem paper_lower (q ρ : ℝ) (hq : 0 ≤ q)
    (hqmax : q ≤ Real.sqrt (5/6 : ℝ)) (hρ : 0 ≤ ρ) :
    Paper.scalarF parameters sigma q ρ ≥
      (lowerMargin : ℝ)*(1+ρ+ρ^2) := by
  have hsqrt : (Real.sqrt (5/6 : ℝ))^2 = (5/6 : ℝ) :=
    Real.sq_sqrt (by norm_num)
  have hproduct := mul_nonneg (sub_nonneg.mpr hqmax)
    (add_nonneg (Real.sqrt_nonneg (5/6 : ℝ)) hq)
  have hq_sq : q^2 ≤ (5/6 : ℝ) := by nlinarith
  change (lowerMargin : ℝ)*(1+ρ+ρ^2) ≤ Paper.scalarF parameters sigma q ρ
  rw [ScalarBridge.scalarF_eq _ _ _ _ hρ]
  simpa only [show (Real.sqrt ρ)^4 = ρ^2 by rw [show (4:ℕ)=2*2 from rfl,
    pow_mul,Real.sq_sqrt hρ], Real.sq_sqrt hρ] using
    transformed_lower q (Real.sqrt ρ) hq hq_sq (Real.sqrt_nonneg ρ)

