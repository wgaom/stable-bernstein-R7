  Cell["Verification of all bridge intervals", "Subsection"], 
  Cell["We check parameter feasibility, interval coverage, and all 120 \
leading principal minors.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"checkBridge", "[", "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"checks", "=", RowBox[{"{", "}"}]}], 
                ",", RowBox[{"previous", "=", FractionBox["123", "50"]}], 
                ",", "pl", ",", "pr", ",", "b", ",", "c", ",", "d", ",", 
                "\[ScriptL]", ",", "k", ",", "\[Omega]", ",", "\[Tau]", ",", 
                "\[Eta]", ",", "margin", ",", "data", ",", "a", ",", "mins", 
