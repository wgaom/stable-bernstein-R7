                          "\[RightDoubleBracket]"}]}], "-", SuperscriptBox[
                         RowBox[{"off", "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], "2"]}], "]"}], ",", 
                    RowBox[{"Expand", "[", RowBox[{RowBox[{RowBox[{"h", 
                          "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], " ", RowBox[{"h", 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}], " ", RowBox[{"h", 
                          "\[LeftDoubleBracket]", "3", 
                          "\[RightDoubleBracket]"}]}], "+", RowBox[{"2", " ", 
                          RowBox[{"off", "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], " ", RowBox[{"off", 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}], " ", "z"}], "-", 
                        RowBox[{RowBox[{"h", "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], " ", SuperscriptBox[
                          RowBox[{"off", "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}], "2"]}], "-", RowBox[
                         {RowBox[{"h", "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}], " ", SuperscriptBox["z", 
                          "2"]}], "-", RowBox[{RowBox[{"h", 
                          "\[LeftDoubleBracket]", "3", 
                          "\[RightDoubleBracket]"}], " ", SuperscriptBox[
                          RowBox[{"off", "\[LeftDoubleBracket]", "1", 
                          "\[RightDoubleBracket]"}], "2"]}]}], "]"}]}], 
                  "}"}]}], ";", "\[IndentingNewLine]", "  ", RowBox[{"Do", 
                "[", RowBox[{RowBox[{"AppendTo", "[", RowBox[{"result", ",", 
                      RowBox[{"Expand", "[", RowBox[{RowBox[{RowBox[{"h", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], " ", RowBox[{"Last", 
                          "[", "result", "]"}]}], "-", RowBox[{SuperscriptBox[
                          RowBox[{"off", "\[LeftDoubleBracket]", RowBox[
                          {"j", "-", "1"}], "\[RightDoubleBracket]"}], "2"], 
                          " ", RowBox[{"result", "\[LeftDoubleBracket]", 
                          RowBox[{"-", "2"}], "\[RightDoubleBracket]"}]}]}], 
                        "]"}]}], "]"}], ",", RowBox[{"{", RowBox[{"j", ",", 
                      "4", ",", "n"}], "}"}]}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", "result"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", ""}]], "Input"], 
