                   {RowBox[{RowBox[{"K0", " ", "h"}], "-", RowBox[{"Dq", " ", 
                        SuperscriptBox["T0", "2"]}]}], ",", "J0", ",", 
                    RowBox[{"{", RowBox[{"q", ",", "y", ",", "\[Lambda]"}], 
                      "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"L1", "=", RowBox[{RowBox[{RowBox[{"(", RowBox[
                       {RowBox[{"\[ScriptL]", " ", "y"}], "+", "\[Eta]", "-", 
                        "\[Tau]"}], ")"}], " ", "J0"}], "+", RowBox[
                   {"2", " ", "det0", " ", RowBox[{"(", RowBox[{"1", "-", 
                        FractionBox["\[Sigma]", "2"]}], ")"}], " ", 
                    "y"}]}]}], ";", "\[IndentingNewLine]", "  ", 
