noncomputable def z228 : R7.Core.SpectralCoefficient.Kronecker.KeyPoly := R7.Core.SpectralCoefficient.Kronecker.withCoefficients p228 coefficients228
abbrev denominator228 : ℕ := 576
abbrev base228 : ℕ := 13
abbrev degree228 : ℕ := 12
abbrev B228 : ℤ := R7.Algebra.KernelPower.fastPow 2 92
noncomputable abbrev lhs228 := R7.Algebra.Kronecker.Expr.mul (.constant denominator228)
  (R7.Algebra.Kronecker.clearLCM (R7.Core.SpectralCoefficient.Kronecker.weight base228) e228).numerator
noncomputable abbrev rhs228 := R7.Algebra.Kronecker.Expr.mul
  (.constant (R7.Algebra.Kronecker.clearLCM (R7.Core.SpectralCoefficient.Kronecker.weight base228) e228).denominator)
  (R7.Core.SpectralCoefficient.Kronecker.candidate base228 z228)

theorem binding228 : R7.Core.SpectralCoefficient.Kronecker.interpretKey z228 =
    MvPolynomial.C (denominator228 : ℚ) * interpretKey p228 :=
  R7.Core.SpectralCoefficient.Kronecker.scaledCoefficientsEqCross_sound denominator228 p228 coefficients228 (by decide +kernel)

theorem source_homogeneous228 : e228.denote.IsHomogeneous degree228 :=
  R7.Core.SpectralCoefficient.Kronecker.homogeneousDegree_sound e228 degree228 (by decide +kernel)

theorem table_homogeneous228 : (interpretKey p228).IsHomogeneous degree228 := by
  have hh : p228.all (fun a => R7.Core.SpectralCoefficient.Kronecker.totalExp a.exp == degree228) = true := by decide +kernel
  apply R7.Core.SpectralCoefficient.Kronecker.interpret_homogeneous p228 degree228
  intro a ha
  simpa using (List.all_eq_true.mp hh) a ha

theorem order228 : R7.Core.SpectralCoefficient.Kronecker.ordered (R7.Core.SpectralCoefficient.Kronecker.packed base228 z228) = true := by decide +kernel

theorem bound228 : lhs228.bound + rhs228.bound < B228 := by decide +kernel

theorem point228 : lhs228.evaluateFast B228 = rhs228.evaluateFast B228 := by decide +kernel

theorem identity228 : interpretKey p228 = e228.denote := by
  exact R7.Core.SpectralCoefficient.Kronecker.identity_of_evaluation base228 degree228 denominator228
    (by decide) (by decide) (by decide) e228 p228 z228 binding228
    source_homogeneous228 table_homogeneous228 order228 bound228 point228

end KroneckerCertificates

theorem correct202 : interpretKey p202 = e202.denote := by
  have he : computeKey e202=p202 := keyPolyEqual_sound _ _ (by decide +kernel)
  rw [← he]; exact computeKey_correct e202
theorem correct228 : interpretKey p228 = e228.denote := by
  exact KroneckerCertificates.identity228

theorem correct229 : interpretKey p229 = e229.denote := by
  have he : mulKey p202 p228=p229 := keyPolyEqual_sound _ _ (by decide +kernel)
  rw [← he,interpretKey_mul,correct202,correct228]
  rfl
theorem correct230 : interpretKey p230 = e230.denote := by
  have he : negKey p229=p230 := keyPolyEqual_sound _ _ (by decide +kernel)
  rw [← he,interpretKey_neg,correct229]
  rfl
end R7.Core.SpectralCoefficient.Expansion
