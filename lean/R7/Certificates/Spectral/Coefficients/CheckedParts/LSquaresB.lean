noncomputable def z165 : R7.Core.SpectralCoefficient.Kronecker.KeyPoly := R7.Core.SpectralCoefficient.Kronecker.withCoefficients p165 coefficients165
abbrev denominator165 : ℕ := 300
abbrev base165 : ℕ := 11
abbrev degree165 : ℕ := 10
abbrev B165 : ℤ := R7.Algebra.KernelPower.fastPow 2 68
noncomputable abbrev lhs165 := R7.Algebra.Kronecker.Expr.mul (.constant denominator165)
  (R7.Algebra.Kronecker.clearLCM (R7.Core.SpectralCoefficient.Kronecker.weight base165) e165).numerator
noncomputable abbrev rhs165 := R7.Algebra.Kronecker.Expr.mul
  (.constant (R7.Algebra.Kronecker.clearLCM (R7.Core.SpectralCoefficient.Kronecker.weight base165) e165).denominator)
  (R7.Core.SpectralCoefficient.Kronecker.candidate base165 z165)

theorem binding165 : R7.Core.SpectralCoefficient.Kronecker.interpretKey z165 =
    MvPolynomial.C (denominator165 : ℚ) * interpretKey p165 :=
  R7.Core.SpectralCoefficient.Kronecker.scaledCoefficientsEqCross_sound denominator165 p165 coefficients165 (by decide +kernel)

theorem source_homogeneous165 : e165.denote.IsHomogeneous degree165 :=
  R7.Core.SpectralCoefficient.Kronecker.homogeneousDegree_sound e165 degree165 (by decide +kernel)

theorem table_homogeneous165 : (interpretKey p165).IsHomogeneous degree165 := by
  have hh : p165.all (fun a => R7.Core.SpectralCoefficient.Kronecker.totalExp a.exp == degree165) = true := by decide +kernel
  apply R7.Core.SpectralCoefficient.Kronecker.interpret_homogeneous p165 degree165
  intro a ha
  simpa using (List.all_eq_true.mp hh) a ha

theorem order165 : R7.Core.SpectralCoefficient.Kronecker.ordered (R7.Core.SpectralCoefficient.Kronecker.packed base165 z165) = true := by decide +kernel

theorem bound165 : lhs165.bound + rhs165.bound < B165 := by decide +kernel

theorem point165 : lhs165.evaluateFast B165 = rhs165.evaluateFast B165 := by decide +kernel

theorem identity165 : interpretKey p165 = e165.denote := by
  exact R7.Core.SpectralCoefficient.Kronecker.identity_of_evaluation base165 degree165 denominator165
    (by decide) (by decide) (by decide) e165 p165 z165 binding165
    source_homogeneous165 table_homogeneous165 order165 bound165 point165

end KroneckerCertificates

theorem correct156 : interpretKey p156 = e156.denote := by
  exact KroneckerCertificates.identity156

theorem correct165 : interpretKey p165 = e165.denote := by
  exact KroneckerCertificates.identity165

end R7.Core.SpectralCoefficient.Expansion
