              RowBox[{"same", "[", RowBox[{RowBox[{"Total", "[", "nn", "]"}], 
                  ",", "\"Homogeneous Hessian source trace\""}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"vv", "=", RowBox[
                 {RowBox[{"(", RowBox[{RowBox[{"Expand", "[", RowBox[
                         {RowBox[{RowBox[{"(", RowBox[{"g8", "+", RowBox[
                          {"4", " ", "g10"}]}], ")"}], " ", SuperscriptBox[
                          "#1", "3"], " ", "tt"}], "+", RowBox[{RowBox[
                          {"(", RowBox[{"g8", "+", RowBox[{"3", " ", 
                          "g9"}]}], ")"}], " ", "li", " ", SuperscriptBox[
                          "#1", "2"], " ", "tt"}], "+", RowBox[{RowBox[
                          {"(", RowBox[{RowBox[{"\[ScriptL]", " ", 
                          SuperscriptBox["tt", "2"]}], "+", RowBox[{"g8", 
                          " ", RowBox[{"(", RowBox[{RowBox[{"r1", " ", 
                          "tt"}], "-", RowBox[{"2", " ", SuperscriptBox["r1", 
                          "2"]}]}], ")"}]}], "-", RowBox[{"2", " ", "g9", 
                          " ", "s3", " ", "li"}], "-", RowBox[{"2", " ", 
                          "g10", " ", "s4"}]}], ")"}], " ", "#1"}]}], "]"}], 
                      "&"}], ")"}], "/@", "\[Lambda]"}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"covvv", "=", 
                RowBox[{"Expand", "[", RowBox[{"cov", "[", RowBox[{"vv", ",", 
                      "vv", ",", "1"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"covvl", "=", 
                RowBox[{"Expand", "[", RowBox[{"cov", "[", RowBox[{"vv", ",", 
                      "\[Lambda]", ",", "1"}], "]"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"same", "[", 
                RowBox[{RowBox[{"covvv", "-", RowBox[{"freeCov", "[", 
                      RowBox[{"vv", ",", "vv", ",", "1"}], "]"}]}], ",", 
                  "\"Homogeneous Codazzi source cov\""}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"same", "[", 
                RowBox[{RowBox[{"covvl", "-", RowBox[{"freeCov", "[", 
                      RowBox[{"vv", ",", "\[Lambda]", ",", "1"}], "]"}]}], 
                  ",", "\"Homogeneous mixed cov\""}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"lb", "=", RowBox[
                 {"Expand", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[
                         {RowBox[{"2", " ", "b", " ", "cp"}], "-", "1"}], 
                        ")"}], " ", "r1", " ", "tt"}], "+", RowBox[
                     {RowBox[{"(", RowBox[{RowBox[{RowBox[{"-", "b"}], " ", 
                          "vp"}], "-", RowBox[{FractionBox["1", "2"], " ", 
                          "c", " ", "\[Delta]", " ", RowBox[{"(", RowBox[
                          {"1", "-", "\[Delta]"}], ")"}]}], "-", FractionBox[
                          RowBox[{"d", " ", SuperscriptBox["\[Delta]", 
                          "2"]}], "4"], "-", RowBox[{FractionBox["1", "2"], 
                          " ", "\[ScriptL]", " ", RowBox[{"(", RowBox[{"1", 
                          "-", "\[Delta]"}], ")"}]}]}], ")"}], " ", 
                      SuperscriptBox["tt", "2"]}], "+", RowBox[{"g8", " ", 
                      RowBox[{"(", RowBox[{RowBox[{"2", " ", "cp", " ", 
                          SuperscriptBox["r1", "2"]}], "-", FractionBox[
                          RowBox[{"\[Sigma]", " ", "s4"}], "10"]}], ")"}]}], 
                    "+", RowBox[{"2", " ", "g9", " ", "cp", " ", "s3", " ", 
                      "li"}], "+", RowBox[{"g10", " ", RowBox[{"(", RowBox[
                         {"2", "-", "\[Sigma]"}], ")"}], " ", "s4"}]}], 
                  "]"}]}], ";", "\[IndentingNewLine]", "  ", RowBox[{"a0", 
                "=", RowBox[{"If", "[", RowBox[{RowBox[{"\[Sigma]", 
                      "\[Equal]", FractionBox["5", "2"]}], ",", "0", ",", 
                    "pureMargin"}], "]"}]}], ";", "\[IndentingNewLine]", 
              "  ", RowBox[{"ap", "=", RowBox[{"Expand", "[", RowBox[
                   {RowBox[{"(", RowBox[{"alpha", "-", "a0"}], ")"}], " ", 
                    "den"}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"lp", "=", RowBox[{"Expand", "[", RowBox[
                   {RowBox[{"4", " ", RowBox[{"(", RowBox[{"d", "-", "c"}], 
                        ")"}], " ", "dd", " ", SuperscriptBox["tt", "3"], 
                      " ", "lb"}], "-", RowBox[{"dd", " ", "covvv"}], "-", 
                    RowBox[{"d", " ", SuperscriptBox["covvl", "2"]}], "-", 
                    RowBox[{"curveMargin", " ", "den"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"q8", "=", RowBox[
                 {"Expand", "[", RowBox[{RowBox[{RowBox[{"(", RowBox[
                         {"c", "-", "curveMargin"}], ")"}], " ", 
                      SuperscriptBox["tt", "4"]}], "-", FractionBox[
                     RowBox[{"Total", "[", SuperscriptBox["nn", "2"], "]"}], 
                     "4"]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"qp", "=", RowBox[{"Expand", "[", RowBox[{"4", " ", 
                    RowBox[{"(", RowBox[{"d", "-", "c"}], ")"}], " ", "dd", 
                    " ", "tt", " ", "q8"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"Do", "[", RowBox[
                 {RowBox[{"check", "[", RowBox[{RowBox[{"AllTrue", "[", 
                        RowBox[{RowBox[{"First", "/@", RowBox[
                          {"CoefficientRules", "[", RowBox[{"poly", ",", 
                          "vars"}], "]"}]}], ",", RowBox[{RowBox[{RowBox[
                          {"Total", "[", "#1", "]"}], "\[Equal]", "12"}], 
                          "&"}]}], "]"}], ",", 
                      "\"Spectral homogeneous degree twelve\""}], "]"}], ",", 
                  RowBox[{"{", RowBox[{"poly", ",", RowBox[{"DeleteCases", 
                        "[", RowBox[{RowBox[{"{", RowBox[{"ap", ",", "lp", 
                          ",", "qp"}], "}"}], ",", "0"}], "]"}]}], "}"}]}], 
                "]"}], ";", "\[IndentingNewLine]", "  ", RowBox[{"check", 
                "[", RowBox[{RowBox[{"AllTrue", "[", RowBox[{RowBox[{"First", 
                        "/@", RowBox[{"CoefficientRules", "[", RowBox[{"q8", 
                          ",", "vars"}], "]"}]}], ",", RowBox[{RowBox[
                         {RowBox[{"Total", "[", "#1", "]"}], "\[Equal]", 
                          "8"}], "&"}]}], "]"}], ",", 
                  "\"Spectral homogeneous degree eight\""}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"check", "[", 
                RowBox[{RowBox[{"FreeQ", "[", RowBox[{RowBox[{"{", RowBox[
                         {"ap", ",", "lp", ",", "qp", ",", "q8"}], "}"}], 
                      ",", "_Real"}], "]"}], ",", 
                  "\"Inexact spectral polynomial\""}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"Association", "[", 
                RowBox[{RowBox[{"\"Polynomials\"", "\[Rule]", RowBox[
                     {"{", RowBox[{"ap", ",", "lp", ",", "qp"}], "}"}]}], 
                  ",", RowBox[{"\"Q8\"", "\[Rule]", "q8"}], ",", 
                  RowBox[{"\"Variables\"", "\[Rule]", "vars"}]}], "]"}]}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", ""}]], "Input"], 
  Cell["Gap expansion and reflection symmetry", "Subsection"], 
  Cell["Direct reconstruction and spectral reversal are checked before \
selecting representative slices.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"powers", "[", RowBox[{"n_Integer", ",", "1"}], "]"}], 
        ":=", RowBox[{"{", RowBox[{"{", "n", "}"}], "}"}]}], ";", 
      "\[IndentingNewLine]", "", 
      RowBox[{RowBox[{"powers", "[", RowBox[{"n_Integer", ",", 
            "length_Integer"}], "]"}], ":=", 
        RowBox[{RowBox[{"powers", "[", RowBox[{"n", ",", "length"}], "]"}], 
          "=", RowBox[{"Flatten", "[", RowBox[{RowBox[{"Table", "[", 
                RowBox[{RowBox[{RowBox[{"(", RowBox[{RowBox[{"Prepend", "[", 
                          RowBox[{"#1", ",", "k"}], "]"}], "&"}], ")"}], 
                    "/@", RowBox[{"powers", "[", RowBox[{RowBox[{"n", "-", 
                          "k"}], ",", RowBox[{"length", "-", "1"}]}], 
                      "]"}]}], ",", RowBox[{"{", RowBox[{"k", ",", "0", ",", 
                      "n"}], "}"}]}], "]"}], ",", "1"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", ""}]], "Input"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"slices", "[", RowBox[{"polys_List", ",", "vars_List", 
            ",", "n_Integer"}], "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"indices", ",", "index", ",", "scale", 
                ",", "rules", ",", "arrays", ",", "k", ",", "alpha", ",", 
                "co", ",", "beta", ",", "mult", ",", "pos", ",", 
                "reconstructed", ",", "direct", ",", "representatives", ",", 
                "reversed", ",", "sgn"}], "}"}], ",", 
            RowBox[{RowBox[{"indices", "=", RowBox[{"powers", "[", 
                  RowBox[{"n", ",", "4"}], "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"index", "=", 
                RowBox[{"AssociationThread", "[", RowBox[{"indices", ",", 
                    RowBox[{"Range", "[", RowBox[{"Length", "[", "indices", 
                        "]"}], "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
              "  ", RowBox[{"rules", "=", RowBox[{RowBox[{"(", RowBox[
                     {RowBox[{"CoefficientRules", "[", RowBox[{"#1", ",", 
                          "vars"}], "]"}], "&"}], ")"}], "/@", "polys"}]}], 
              ";", "\[IndentingNewLine]", "  ", RowBox[{"check", "[", 
                RowBox[{RowBox[{"AllTrue", "[", RowBox[{RowBox[{"Flatten", 
                        "[", RowBox[{"Map", "[", RowBox[{"Last", ",", 
                          "rules", ",", RowBox[{"{", "2", "}"}]}], "]"}], 
                        "]"}], ",", "rationalQ"}], "]"}], ",", 
                  "\"Nonrational slice coefficients\""}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"scale", "=", 
                RowBox[{"LCM", "@@", RowBox[{"Denominator", "/@", RowBox[
                     {"Flatten", "[", RowBox[{"Map", "[", RowBox[{"Last", 
                          ",", "rules", ",", RowBox[{"{", "2", "}"}]}], 
                        "]"}], "]"}]}]}]}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"check", "[", RowBox[{RowBox[{RowBox[{"IntegerQ", "[", 
                      "scale", "]"}], "&&", RowBox[{"scale", ">", "0"}]}], 
                  ",", "\"Invalid common denominator\""}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"arrays", "=", 
                RowBox[{"ConstantArray", "[", RowBox[{"0", ",", RowBox[
                     {"{", RowBox[{RowBox[{"Length", "[", "indices", "]"}], 
                        ",", RowBox[{"Length", "[", "polys", "]"}], ",", 
                        RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"Do", "[", RowBox[
                 {RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"k", "=", 
                          RowBox[{"First", "[", RowBox[{"First", "[", "term", 
                          "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
                        "      ", RowBox[{"alpha", "=", RowBox[{"Rest", "[", 
                          RowBox[{"First", "[", "term", "]"}], "]"}]}], ";", 
                        "\[IndentingNewLine]", "      ", RowBox[{"co", "=", 
                          RowBox[{"scale", " ", RowBox[{"Last", "[", "term", 
                          "]"}]}]}], ";", "\[IndentingNewLine]", "      ", 
                        RowBox[{"check", "[", RowBox[{RowBox[{RowBox[
                          {RowBox[{"k", "+", RowBox[{"Total", "[", "alpha", 
                          "]"}]}], "\[Equal]", "n"}], "&&", RowBox[
                          {"IntegerQ", "[", "co", "]"}]}], ",", 
                          "\"Slice degree or denominator\""}], "]"}], ";", 
                        "\[IndentingNewLine]", "      ", RowBox[{"Do", "[", 
                          RowBox[{RowBox[{RowBox[{"beta", "=", RowBox[
                          {"alpha", "+", "extra"}]}], ";", 
                          "\[IndentingNewLine]", "        ", RowBox[{"mult", 
                          "=", FractionBox[RowBox[{"k", "!"}], RowBox[
                          {"Times", "@@", RowBox[{"Factorial", "/@", 
                          "extra"}]}]]}], ";", "\[IndentingNewLine]", 
                          "        ", RowBox[{"pos", "=", RowBox[{"index", 
                          "[", "beta", "]"}]}], ";", "\[IndentingNewLine]", 
                          "        ", RowBox[{RowBox[{"arrays", 
                          "\[LeftDoubleBracket]", RowBox[{"pos", ",", "j", 
                          ",", RowBox[{"k", "+", "1"}]}], 
                          "\[RightDoubleBracket]"}], "+=", RowBox[{"co", " ", 
                          "mult"}]}]}], ",", RowBox[{"{", RowBox[{"extra", 
                          ",", RowBox[{"powers", "[", RowBox[{"k", ",", 
                          "4"}], "]"}]}], "}"}]}], "]"}]}], ",", RowBox[
                       {"{", RowBox[{"term", ",", RowBox[{"rules", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ",", 
                  RowBox[{"{", RowBox[{"j", ",", RowBox[{"Length", "[", 
                        "polys", "]"}]}], "}"}]}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"Do", "[", RowBox[
                 {RowBox[{RowBox[{"reconstructed", "=", RowBox[{"Total", "[", 
                        RowBox[{"Table", "[", RowBox[{RowBox[{RowBox[
                          {"Times", "@@", RowBox[{"MapThread", "[", RowBox[
                          {"Power", ",", RowBox[{"{", RowBox[{RowBox[{"Rest", 
                          "[", "vars", "]"}], ",", RowBox[{"indices", 
                          "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}]}], "}"}]}], "]"}]}], " ", 
                          RowBox[{UnderoverscriptBox["\[Sum]", RowBox[{"k", 
                          "=", "0"}], "n"], RowBox[{RowBox[{"arrays", 
                          "\[LeftDoubleBracket]", RowBox[{"i", ",", "j", ",", 
                          RowBox[{"k", "+", "1"}]}], 
                          "\[RightDoubleBracket]"}], " ", SuperscriptBox[
                          RowBox[{"First", "[", "vars", "]"}], "k"]}]}]}], 
                          ",", RowBox[{"{", RowBox[{"i", ",", RowBox[
                          {"Length", "[", "indices", "]"}]}], "}"}]}], "]"}], 
                        "]"}]}], ";", "\[IndentingNewLine]", "    ", 
                    RowBox[{"direct", "=", RowBox[{"Expand", "[", RowBox[
                         {"scale", " ", RowBox[{"(", RowBox[{RowBox[{"polys", 
                          "\[LeftDoubleBracket]", "j", 
                          "\[RightDoubleBracket]"}], "/.", 
                          "\[VeryThinSpace]", RowBox[{RowBox[{"First", "[", 
                          "vars", "]"}], "\[Rule]", RowBox[{RowBox[{"First", 
                          "[", "vars", "]"}], " ", RowBox[{"Total", "[", 
                          RowBox[{"Rest", "[", "vars", "]"}], "]"}]}]}]}], 
                          ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
                    "    ", RowBox[{"same", "[", RowBox[{RowBox[{"direct", 
                          "-", "reconstructed"}], ",", "\"Direct substitution \
differs from multinomial slicing\""}], "]"}]}], ",", RowBox[{"{", RowBox[
                     {"j", ",", RowBox[{"Length", "[", "polys", "]"}]}], 
                    "}"}]}], "]"}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"sgn", "=", RowBox[{"Table", "[", RowBox[
                   {SuperscriptBox[RowBox[{"(", RowBox[{"-", "1"}], ")"}], 
                     "k"], ",", RowBox[{"{", RowBox[{"k", ",", "0", ",", 
                        "n"}], "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
              "  ", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"reversed", 
                      "=", RowBox[{"index", "[", RowBox[{"Reverse", "[", 
                          RowBox[{"indices", "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}], "]"}], "]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", RowBox[{"check", "[", 
                      RowBox[{RowBox[{RowBox[{"arrays", 
                          "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}], "\[Equal]", RowBox[
                          {RowBox[{"(", RowBox[{RowBox[{"sgn", " ", "#1"}], 
                          "&"}], ")"}], "/@", RowBox[{"arrays", 
                          "\[LeftDoubleBracket]", "reversed", 
                          "\[RightDoubleBracket]"}]}]}], ",", 
                        "\"Spectral reflection identity\""}], "]"}]}], ",", 
                  RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", 
                        "indices", "]"}]}], "}"}]}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"representatives", "=", 
                RowBox[{"Select", "[", RowBox[{RowBox[{"Range", "[", 
                      RowBox[{"Length", "[", "indices", "]"}], "]"}], ",", 
                    RowBox[{RowBox[{"OrderedQ", "[", RowBox[{"{", RowBox[
                          {RowBox[{"indices", "\[LeftDoubleBracket]", "#1", 
                          "\[RightDoubleBracket]"}], ",", RowBox[{"Reverse", 
                          "[", RowBox[{"indices", "\[LeftDoubleBracket]", 
                          "#1", "\[RightDoubleBracket]"}], "]"}]}], "}"}], 
                        "]"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
              "  ", RowBox[{"Association", "[", RowBox[{RowBox[
                   {"\"Indices\"", "\[Rule]", RowBox[{"indices", 
                      "\[LeftDoubleBracket]", "representatives", 
                      "\[RightDoubleBracket]"}]}], ",", RowBox[{"\"Arrays\"", 
                    "\[Rule]", RowBox[{"arrays", "\[LeftDoubleBracket]", 
                      "representatives", "\[RightDoubleBracket]"}]}], ",", 
                  RowBox[{"\"Scale\"", "\[Rule]", "scale"}], ",", 
                  RowBox[{"\"TotalSlices\"", "\[Rule]", RowBox[{"Length", 
                      "[", "indices", "]"}]}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", ""}]], "Input"], 
  Cell["Example: one slice at the entry exponent", "Subsection"], 
