  Cell["Verification at the entry and critical exponents", "Subsection"], 
  Cell["We check the entry and critical exponents, including the zero-gap \
boundary.", "Text"], 
  Cell[BoxData[RowBox[{RowBox[{RowBox[{"checkSpectral", "[", "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"conditions", 
                ",", "entry", ",", "critical", ",", "parts", ",", "arrays", 
                ",", "\[Rho]", ",", "a", ",", "tests", ",", RowBox[
                 {"checks", "=", RowBox[{"{", "}"}]}], ",", RowBox[
                 {"maxDegree", "=", "0"}], ",", RowBox[{"critReports", "=", 
                  RowBox[{"Association", "[", "]"}]}], ",", "mins", ",", "n", 
                ",", "corrected", ",", "expected", ",", "name", ",", "data", 
                ",", "poly", ",", "degree", ",", "rows", ",", RowBox[
                 {"gapChecks", "=", RowBox[{"{", "}"}]}], ",", 
                "criticalChecks"}], "}"}], ",", RowBox[
             {RowBox[{"conditions", "=", RowBox[{"parameters", "[", "]"}]}], 
              ";", RowBox[{"Print", "[", "\"Spectral entry: reconstructing \
homogeneous polynomials and slices\"", "]"}], ";", RowBox[{"entry", "=", 
                RowBox[{"spectral", "[", FractionBox["12481", "5000"], 
                  "]"}]}], ";", RowBox[{"parts", "=", RowBox[{"slices", "[", 
                  RowBox[{RowBox[{"entry", "[", "\"Polynomials\"", "]"}], 
                    ",", RowBox[{"entry", "[", "\"Variables\"", "]"}], ",", 
                    "12"}], "]"}]}], ";", RowBox[{"check", "[", 
                RowBox[{RowBox[{RowBox[{RowBox[{"Length", "[", RowBox[
                         {"parts", "[", "\"Indices\"", "]"}], "]"}], 
                      "\[Equal]", "231"}], "&&", RowBox[{RowBox[{"parts", 
                        "[", "\"TotalSlices\"", "]"}], "\[Equal]", "455"}]}], 
                  ",", "\"Spectral entry slice coverage\""}], "]"}], ";", 
              RowBox[{"arrays", "=", RowBox[{"parts", "[", "\"Arrays\"", 
                  "]"}]}], ";", RowBox[{"Do", "[", RowBox[
                 {RowBox[{RowBox[{"If", "[", RowBox[{RowBox[{RowBox[{"Mod", 
                          "[", RowBox[{RowBox[{"i", "-", "1"}], ",", "20"}], 
                          "]"}], "\[Equal]", "0"}], ",", RowBox[{"Print", 
                          "[", RowBox[{"\"Spectral entry matrix \"", ",", 
                          "i", ",", "\"/231\""}], "]"}]}], "]"}], ";", 
                    RowBox[{"a", "=", RowBox[{"Table", "[", RowBox[
                         {RowBox[{RowBox[{"arrays", "\[LeftDoubleBracket]", 
                          RowBox[{"i", ",", "1", ",", "k"}], 
                          "\[RightDoubleBracket]"}], "+", RowBox[{"\[Rho]", 
                          " ", RowBox[{"arrays", "\[LeftDoubleBracket]", 
                          RowBox[{"i", ",", "2", ",", "k"}], 
                          "\[RightDoubleBracket]"}]}], "+", RowBox[
                          {SuperscriptBox["\[Rho]", "2"], " ", RowBox[
                          {"arrays", "\[LeftDoubleBracket]", RowBox[{"i", 
                          ",", "3", ",", "k"}], 
                          "\[RightDoubleBracket]"}]}]}], ",", RowBox[{"{", 
                          RowBox[{"k", ",", "13"}], "}"}]}], "]"}]}], ";", 
                    RowBox[{"tests", "=", RowBox[{RowBox[{"(", RowBox[
                          {RowBox[{"sturm", "[", RowBox[{"#1", ",", 
                          "\[Rho]"}], "]"}], "&"}], ")"}], "/@", RowBox[
                         {"minors", "[", RowBox[{"a", ",", "True"}], 
                          "]"}]}]}], ";", RowBox[{"check", "[", RowBox[
                       {RowBox[{"And", "@@", RowBox[{"MapThread", "[", 
                          RowBox[{RowBox[{RowBox[{RowBox[{"#1", "[", 
                          "\"Degree\"", "]"}], "\[LessEqual]", "#2"}], "&"}], 
                          ",", RowBox[{"{", RowBox[{"tests", ",", RowBox[
                          {"Range", "[", RowBox[{"2", ",", "14", ",", "2"}], 
                          "]"}]}], "}"}]}], "]"}]}], ",", 
                        "\"Spectral minor degree bounds\""}], "]"}], ";", 
                    RowBox[{"maxDegree", "=", RowBox[{"Max", "[", RowBox[
                         {"maxDegree", ",", RowBox[{"Max", "[", RowBox[
                          {"Lookup", "[", RowBox[{"tests", ",", 
                          "\"Degree\""}], "]"}], "]"}]}], "]"}]}], ";", 
                    RowBox[{"AppendTo", "[", RowBox[{"gapChecks", ",", 
                        RowBox[{"sturm", "[", RowBox[{RowBox[{"Last", "[", 
                          "a", "]"}], ",", "\[Rho]"}], "]"}]}], "]"}], ";", 
                    RowBox[{"AppendTo", "[", RowBox[{"checks", ",", RowBox[
                         {"Association", "[", RowBox[{RowBox[{"\"Index\"", 
                          "\[Rule]", RowBox[{RowBox[{"parts", "[", 
                          "\"Indices\"", "]"}], "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}]}], ",", RowBox[
                          {"\"Minors\"", "\[Rule]", "tests"}]}], "]"}]}], 
                      "]"}]}], ",", RowBox[{"{", RowBox[{"i", ",", "231"}], 
                    "}"}]}], "]"}], ";", RowBox[{"Print", "[", 
                "\"Critical spectral endpoint: reconstructing\"", "]"}], ";", 
              RowBox[{"critical", "=", RowBox[{"spectral", "[", FractionBox[
                   "5", "2"], "]"}]}], ";", RowBox[{"check", "[", 
                RowBox[{RowBox[{RowBox[{"First", "[", RowBox[{"critical", 
                        "[", "\"Polynomials\"", "]"}], "]"}], "===", "0"}], 
                  ",", "\"Critical pure polynomial is not zero\""}], "]"}], 
              ";", RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{RowBox[
                       {"{", RowBox[{"name", ",", "poly", ",", "degree", ",", 
                          "corrected", ",", "expected"}], "}"}], "=", 
                      "spec"}], ";", RowBox[{"data", "=", RowBox[{"slices", 
                        "[", RowBox[{RowBox[{"{", "poly", "}"}], ",", 
                          RowBox[{"critical", "[", "\"Variables\"", "]"}], 
                          ",", "degree"}], "]"}]}], ";", RowBox[{"rows", "=", 
                      RowBox[{"data", "[", "\"Arrays\"", "]"}]}], ";", 
                    RowBox[{"check", "[", RowBox[{RowBox[{RowBox[{RowBox[
                          {"Length", "[", "rows", "]"}], "\[Equal]", 
                          "expected"}], "&&", RowBox[{RowBox[{"data", "[", 
                          "\"TotalSlices\"", "]"}], "\[Equal]", RowBox[
                          {"Binomial", "[", RowBox[{RowBox[{"degree", "+", 
                          "3"}], ",", "3"}], "]"}]}]}], ",", 
                        "\"Critical slice coverage\""}], "]"}], ";", 
                    RowBox[{"criticalChecks", "=", RowBox[{"{", "}"}]}], ";", 
                    RowBox[{"Do", "[", RowBox[{RowBox[{RowBox[{"a", "=", 
                          RowBox[{"First", "[", RowBox[{"rows", 
                          "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}], "]"}]}], ";", RowBox[
                          {"mins", "=", RowBox[{"minors", "[", RowBox[{"a", 
                          ",", "corrected"}], "]"}]}], ";", RowBox[{"check", 
                          "[", RowBox[{RowBox[{RowBox[{"AllTrue", "[", RowBox[
                          {"mins", ",", RowBox[{RowBox[{"#1", ">", "0"}], 
                          "&"}]}], "]"}], "&&", RowBox[{RowBox[{"Last", "[", 
                          "a", "]"}], ">", "0"}]}], ",", 
                          "\"Nonpositive critical minor or zero-gap limit\""}]\
, "]"}], ";", RowBox[{"AppendTo", "[", RowBox[{"criticalChecks", ",", RowBox[
                          {"Association", "[", RowBox[{RowBox[{"\"Index\"", 
                          "\[Rule]", RowBox[{RowBox[{"data", "[", 
                          "\"Indices\"", "]"}], "\[LeftDoubleBracket]", "i", 
                          "\[RightDoubleBracket]"}]}], ",", RowBox[
                          {"\"MinorSigns\"", "\[Rule]", RowBox[{"Sign", "/@", 
                          "mins"}]}], ",", RowBox[{"\"ZeroGapSign\"", 
                          "\[Rule]", RowBox[{"Sign", "[", RowBox[{"Last", 
                          "[", "a", "]"}], "]"}]}]}], "]"}]}], "]"}]}], ",", 
                        RowBox[{"{", RowBox[{"i", ",", RowBox[{"Length", "[", 
                          "rows", "]"}]}], "}"}]}], "]"}], ";", RowBox[
                     {"AssociateTo", "[", RowBox[{"critReports", ",", 
                        RowBox[{"name", "\[Rule]", RowBox[{"Association", 
                          "[", RowBox[{RowBox[{"\"Matrices\"", "\[Rule]", 
                          "expected"}], ",", RowBox[{"\"MinorSigns\"", 
                          "\[Rule]", RowBox[{"expected", " ", RowBox[{"(", 
                          RowBox[{FractionBox["degree", "2"], "+", "1"}], 
                          ")"}]}]}], ",", RowBox[{"\"CommonDenominator\"", 
                          "\[Rule]", RowBox[{"data", "[", "\"Scale\"", 
                          "]"}]}], ",", RowBox[{"\"Checks\"", "\[Rule]", 
                          "criticalChecks"}]}], "]"}]}]}], "]"}]}], ",", 
                  RowBox[{"{", RowBox[{"spec", ",", RowBox[{"{", RowBox[
                         {RowBox[{"{", RowBox[{"\"CriticalL\"", ",", RowBox[
                          {RowBox[{"critical", "[", "\"Polynomials\"", "]"}], 
                          "\[LeftDoubleBracket]", "2", 
                          "\[RightDoubleBracket]"}], ",", "12", ",", "True", 
                          ",", "231"}], "}"}], ",", RowBox[{"{", RowBox[
                          {"\"CriticalQ8\"", ",", RowBox[{"critical", "[", 
                          "\"Q8\"", "]"}], ",", "8", ",", "False", ",", 
                          "85"}], "}"}]}], "}"}]}], "}"}]}], "]"}], ";", 
              RowBox[{"check", "[", RowBox[{RowBox[{RowBox[{RowBox[
                       {RowBox[{"Length", "[", "checks", "]"}], " ", "7"}], 
                      "\[Equal]", "1617"}], "&&", RowBox[{RowBox[
                       {RowBox[{RowBox[{"critReports", "[", "\"CriticalL\"", 
                          "]"}], "[", "\"MinorSigns\"", "]"}], "+", RowBox[
                         {RowBox[{"critReports", "[", "\"CriticalQ8\"", 
                          "]"}], "[", "\"MinorSigns\"", "]"}]}], "\[Equal]", 
                      "2042"}]}], ",", 
                  "\"Incomplete spectral minor coverage\""}], "]"}], ";", 
              RowBox[{"Association", "[", RowBox[{RowBox[{"\"Status\"", 
                    "\[Rule]", "\"PASS\""}], ",", RowBox[
                   {"\"ParameterConditions\"", "\[Rule]", "conditions"}], 
                  ",", RowBox[{"\"EntryMatrices\"", "\[Rule]", "231"}], ",", 
                  RowBox[{"\"EntryMinorTests\"", "\[Rule]", "1617"}], ",", 
                  RowBox[{"\"MaximumDegree\"", "\[Rule]", "maxDegree"}], ",", 
                  RowBox[{"\"CommonDenominator\"", "\[Rule]", RowBox[
                     {"parts", "[", "\"Scale\"", "]"}]}], ",", RowBox[
                   {"\"EntryChecks\"", "\[Rule]", "checks"}], ",", 
                  RowBox[{"\"ZeroGapChecks\"", "\[Rule]", "gapChecks"}], ",", 
                  RowBox[{"\"Critical\"", "\[Rule]", "critReports"}], ",", 
                  RowBox[{"\"Reflection\"", "\[Rule]", "\"PASS\""}], ",", 
                  RowBox[{"\"DirectSubstitution\"", "\[Rule]", 
                    "\"PASS\""}]}], "]"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]"}]], "Input"], 
  Cell[CellGroupData[
    {Cell[BoxData[RowBox[{RowBox[{"spectralResult", "=", 
           RowBox[{"run", "[", RowBox[{"checkSpectral", "[", "]"}], "]"}]}], 
         ";", "\[IndentingNewLine]", "", 
         TagBox[GridBox[{{"\"Block\"", "\"Matrices\"", "\"Minor checks\""}, 
            {"\"Entry\"", RowBox[{"spectralResult", "[", "\"EntryMatrices\"", 
               "]"}], RowBox[{"spectralResult", "[", "\"EntryMinorTests\"", 
               "]"}]}, {"\"Critical linear\"", RowBox[{RowBox[
                {RowBox[{"spectralResult", "[", "\"Critical\"", "]"}], "[", 
                 "\"CriticalL\"", "]"}], "[", "\"Matrices\"", "]"}], 
             RowBox[{RowBox[{RowBox[{"spectralResult", "[", "\"Critical\"", 
                   "]"}], "[", "\"CriticalL\"", "]"}], "[", "\"MinorSigns\"", 
               "]"}]}, {"\"Critical quadratic\"", RowBox[{RowBox[
                {RowBox[{"spectralResult", "[", "\"Critical\"", "]"}], "[", 
                 "\"CriticalQ8\"", "]"}], "[", "\"Matrices\"", "]"}], 
