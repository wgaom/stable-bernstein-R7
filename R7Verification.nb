            RowBox[{RowBox[{"r", "=", FractionBox[RowBox[{"5", " ", 
                   SuperscriptBox["x", "2"]}], RowBox[{"1", "+", RowBox[
                    {"6", " ", SuperscriptBox["x", "2"]}]}]]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"env", "=", 
                RowBox[{FractionBox[RowBox[{"207", " ", SuperscriptBox["r", 
                      "2"]}], "125"], "-", FractionBox[RowBox[{"33", " ", 
                     "r"}], "25"], "+", FractionBox["29", "60"], "+", 
                  FractionBox[RowBox[{"6", " ", "x"}], RowBox[{"5", " ", 
                     SuperscriptBox[RowBox[{"(", RowBox[{"1", "+", RowBox[
                          {"6", " ", SuperscriptBox["x", "2"]}]}], ")"}], 
                      "2"]}]]}]}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"same", "[", RowBox[{RowBox[{"env", "-", RowBox[
                     {"(", RowBox[{FractionBox["8", "15"], "-", FractionBox[
                         SuperscriptBox[RowBox[{"(", RowBox[{RowBox[{"12", 
                          " ", "x"}], "-", "1"}], ")"}], "2"], RowBox[
                          {"20", " ", SuperscriptBox[RowBox[{"(", RowBox[
                          {"1", "+", RowBox[{"6", " ", SuperscriptBox["x", 
                          "2"]}]}], ")"}], "2"]}]]}], ")"}]}], ",", 
                  "\"Rationalized envelope\""}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"Do", "[", RowBox[
                 {RowBox[{RowBox[{RowBox[{"{", RowBox[{"pl", ",", "pr", ",", 
                          "b", ",", "c", ",", "d", ",", "\[ScriptL]", ",", 
                          "k", ",", "\[Omega]", ",", "\[Tau]", ",", 
                          "\[Eta]"}], "}"}], "=", RowBox[{"rows", 
                        "\[LeftDoubleBracket]", "i", 
                        "\[RightDoubleBracket]"}]}], ";", 
                    "\[IndentingNewLine]", "    ", RowBox[{"check", "[", 
                      RowBox[{RowBox[{RowBox[{"pl", "\[Equal]", "previous"}], 
                          "&&", RowBox[{"pr", ">", "pl"}], "&&", RowBox[
                          {"d", ">", RowBox[{"4", " ", "c"}], ">", "0"}], 
                          "&&", RowBox[{"0", "<", "k", "<", FractionBox["4", 
                          "5"]}], "&&", RowBox[{"\[Tau]", "\[GreaterEqual]", 
                          "0"}], "&&", RowBox[{RowBox[{"d", " ", "k"}], ">", 
                          SuperscriptBox["\[Tau]", "2"]}]}], ",", 
                        "\"Bridge parameter or coverage failure\""}], "]"}], 
                    ";", "\[IndentingNewLine]", "    ", RowBox[{"check", "[", 
                      RowBox[{RowBox[{SuperscriptBox["\[Tau]", "2"], "<", 
                          RowBox[{FractionBox["1", "3"], " ", RowBox[{"(", 
                          RowBox[{"d", "-", RowBox[{"4", " ", "c"}]}], ")"}], 
                          " ", RowBox[{"(", RowBox[{FractionBox["6", "5"], 
                          "-", "k"}], ")"}]}]}], ",", 
                        "\"Bridge denominator positivity\""}], "]"}], ";", 
                    "\[IndentingNewLine]", "    ", RowBox[{"check", "[", 
                      RowBox[{RowBox[{RowBox[{RowBox[{RowBox[{"-", 
                          FractionBox["1", "5"]}], "+", FractionBox["k", 
                          "4"]}], "<", "0"}], "&&", RowBox[{RowBox[{"c", "-", 
                          FractionBox["d", "2"]}], "<", "0"}]}], ",", 
                        "\"Bridge concavity bounds\""}], "]"}], ";", 
