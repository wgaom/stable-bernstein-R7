                          {"\[Eta]", "-", RowBox[{"\[Tau]", " ", 
                          "\[Delta]"}]}], ")"}], " ", "y"}]}], ")"}], " ", 
                    "J0"}], "-", RowBox[{"2", " ", "det0", " ", RowBox[
                     {"(", RowBox[{"1", "-", FractionBox["\[Sigma]", "2"]}], 
                      ")"}], " ", SuperscriptBox["y", "2"]}]}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"L0", "=", RowBox[
                 {RowBox[{RowBox[{"(", RowBox[{RowBox[{"2", " ", "b", " ", 
                          RowBox[{"(", RowBox[{"1", "-", FractionBox[
                          "\[Sigma]", "5"]}], ")"}]}], "-", "1"}], ")"}], 
                    " ", "q"}], "-", RowBox[{"b", " ", RowBox[{"(", 
                      RowBox[{"1", "-", FractionBox[RowBox[{"2", " ", 
                          "\[Sigma]"}], "5"]}], ")"}]}], "+", "k", "-", 
