noncomputable def gapPowerData0 : KeyPoly := r7_key_poly%[
  ⟨0,![0,0,0,0,0],1⟩]

theorem gapPowerData0_integer_view : R7.Core.SpectralCoefficient.Kronecker.IntegerView.tableCheck gapPowerData0 0 = true := by decide +kernel

theorem gapPowerData0_correct : interpretKey gapPowerData0 = gapSum^0 := by
  have he : constantKey 1 = gapPowerData0 := keyPolyEqual_sound _ _ (by decide +kernel)
  rw [← he, interpretKey_constant]
  simp

