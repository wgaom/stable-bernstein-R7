noncomputable def z196 : R7.Core.SpectralCoefficient.Kronecker.KeyPoly := R7.Core.SpectralCoefficient.Kronecker.withCoefficients p196 coefficients196
abbrev denominator196 : ℕ := 96
abbrev base196 : ℕ := 11
abbrev degree196 : ℕ := 10
abbrev B196 : ℤ := R7.Algebra.KernelPower.fastPow 2 74
noncomputable abbrev lhs196 := R7.Algebra.Kronecker.Expr.mul (.constant denominator196)
  (R7.Algebra.Kronecker.clearLCM (R7.Core.SpectralCoefficient.Kronecker.weight base196) e196).numerator
noncomputable abbrev rhs196 := R7.Algebra.Kronecker.Expr.mul
  (.constant (R7.Algebra.Kronecker.clearLCM (R7.Core.SpectralCoefficient.Kronecker.weight base196) e196).denominator)
  (R7.Core.SpectralCoefficient.Kronecker.candidate base196 z196)

theorem binding196 : R7.Core.SpectralCoefficient.Kronecker.interpretKey z196 =
    MvPolynomial.C (denominator196 : ℚ) * interpretKey p196 :=
  R7.Core.SpectralCoefficient.Kronecker.scaledCoefficientsEqCross_sound denominator196 p196 coefficients196 (by decide +kernel)

theorem source_homogeneous196 : e196.denote.IsHomogeneous degree196 :=
  R7.Core.SpectralCoefficient.Kronecker.homogeneousDegree_sound e196 degree196 (by decide +kernel)

theorem table_homogeneous196 : (interpretKey p196).IsHomogeneous degree196 := by
  have hh : p196.all (fun a => R7.Core.SpectralCoefficient.Kronecker.totalExp a.exp == degree196) = true := by decide +kernel
  apply R7.Core.SpectralCoefficient.Kronecker.interpret_homogeneous p196 degree196
  intro a ha
  simpa using (List.all_eq_true.mp hh) a ha

theorem order196 : R7.Core.SpectralCoefficient.Kronecker.ordered (R7.Core.SpectralCoefficient.Kronecker.packed base196 z196) = true := by decide +kernel

theorem bound196 : lhs196.bound + rhs196.bound < B196 := by decide +kernel

theorem point196 : lhs196.evaluateFast B196 = rhs196.evaluateFast B196 := by decide +kernel

theorem identity196 : interpretKey p196 = e196.denote := by
  exact R7.Core.SpectralCoefficient.Kronecker.identity_of_evaluation base196 degree196 denominator196
    (by decide) (by decide) (by decide) e196 p196 z196 binding196
    source_homogeneous196 table_homogeneous196 order196 bound196 point196

end KroneckerCertificates

theorem correct196 : interpretKey p196 = e196.denote := by
  exact KroneckerCertificates.identity196

