                          " ", "\[Delta]"}], "+", RowBox[{"\[Eta]", " ", 
                          RowBox[{"(", RowBox[{"1", "-", FractionBox[
                          "\[Sigma]", "2"]}], ")"}]}]}], ")"}], " ", "y"}], 
                  "-", RowBox[{FractionBox["1", "4"], " ", SuperscriptBox[
                     "b", "2"], " ", RowBox[{"(", RowBox[{"\[Lambda]", "-", 
                        RowBox[{FractionBox["6", "5"], " ", SuperscriptBox[
                          RowBox[{"(", RowBox[{"q", "-", FractionBox["1", 
                          "6"]}], ")"}], "2"]}]}], ")"}], " ", SuperscriptBox[
                     "y", "4"]}], "-", RowBox[{"margin", " ", RowBox[
                     {"(", RowBox[{"1", "+", SuperscriptBox["y", "2"], "+", 
                        SuperscriptBox["y", "4"]}], ")"}]}]}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"num", "=", 
                RowBox[{RowBox[{"4", " ", SuperscriptBox["J0", "2"], " ", 
                    "D0", " ", "base"}], "+", RowBox[{"4", " ", "det0", " ", 
                    SuperscriptBox[RowBox[{"(", RowBox[{"1", "-", FractionBox[
                          "\[Sigma]", "2"]}], ")"}], "2"], " ", 
                    SuperscriptBox["y", "2"], " ", "J0", " ", "D0"}], "-", 
                  RowBox[{"Dq", " ", "K0", " ", SuperscriptBox["L1", "2"]}], 
                  "-", RowBox[{"2", " ", "Dq", " ", "T0", " ", "L1", " ", 
                    "L2"}], "-", RowBox[{"h", " ", SuperscriptBox["L2", 
                     "2"]}]}]}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"poly0", "=", RowBox[{"quotient", "[", RowBox[
                   {"num", ",", SuperscriptBox["J0", "2"], ",", RowBox[
                     {"{", RowBox[{"q", ",", "y", ",", "\[Lambda]"}], 
                      "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"sequential", "=", RowBox[{"quotient", "[", 
                  RowBox[{RowBox[{RowBox[{"4", " ", SuperscriptBox["J0", 
