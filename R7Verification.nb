Notebook[{Cell["Algebraic verification of Propositions 8.1 and 10.1", 
   "Title"], Cell["1. Parameters and positivity tools", "Section"], 
  Cell[BoxData[RowBox[{RowBox[{"ClearAll", "[", "\"R7Review`*\"", "]"}], ";", 
      "\[IndentingNewLine]", RowBox[{"Begin", "[", "\"R7Review`\"", "]"}], 
      ";", "\[IndentingNewLine]", RowBox[{"failTag", "=", "\"R7Failure\""}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{RowBox[{"check", "[", RowBox[{"test_", ",", "message_"}], 
          "]"}], ":=", RowBox[{"If", "[", RowBox[
           {RowBox[{"!", RowBox[{"TrueQ", "[", "test", "]"}]}], ",", 
            RowBox[{"Throw", "[", RowBox[{RowBox[{"Failure", "[", 
                  RowBox[{"\"Check\"", ",", RowBox[{"Association", "[", 
                      RowBox[{"\"MessageTemplate\"", "\[Rule]", "message"}], 
                      "]"}]}], "]"}], ",", "failTag"}], "]"}]}], "]"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{RowBox[{"same", "[", RowBox[{"expr_", ",", "message_"}], "]"}], 
        ":=", RowBox[{"check", "[", RowBox[
           {RowBox[{RowBox[{"Cancel", "[", RowBox[{"Together", "[", "expr", 
                  "]"}], "]"}], "===", "0"}], ",", "message"}], "]"}]}], ";", 
      "\[IndentingNewLine]", RowBox[{RowBox[{"rationalQ", "[", "a_", "]"}], 
        ":=", RowBox[{RowBox[{"IntegerQ", "[", "a", "]"}], "||", 
          RowBox[{RowBox[{"Head", "[", "a", "]"}], "===", "Rational"}]}]}], 
      ";", "\[IndentingNewLine]", RowBox[{"SetAttributes", "[", 
        RowBox[{"run", ",", "HoldFirst"}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{RowBox[{"run", "[", "expr_", "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"result", "=", 
                RowBox[{"Catch", "[", RowBox[{"expr", ",", "failTag"}], 
                  "]"}]}], "}"}], ",", RowBox[{RowBox[{"If", "[", 
                RowBox[{RowBox[{"FailureQ", "[", "result", "]"}], ",", 
                  RowBox[{RowBox[{"Print", "[", "result", "]"}], ";", 
                    RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
              "result"}]}], "]"}]}], ";", "\[IndentingNewLine]"}]], "Input"], 
