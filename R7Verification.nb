                        "x"}], "]"}], "&&", RowBox[{"f", "=!=", "0"}]}], ",", 
                  "\"Zero or nonpolynomial positivity input\""}], "]"}], ";", 
              RowBox[{"p", "=", RowBox[{"primitive", "[", RowBox[{"f", ",", 
                    "x"}], "]"}]}], ";", RowBox[{"degree", "=", 
                RowBox[{"Exponent", "[", RowBox[{"p", ",", "x"}], "]"}]}], 
              ";", RowBox[{"check", "[", RowBox[{RowBox[{RowBox[
                     {RowBox[{"(", RowBox[{"p", "/.", "\[VeryThinSpace]", 
                          RowBox[{"x", "\[Rule]", "0"}]}], ")"}], ">", "0"}], 
                    "&&", RowBox[{RowBox[{"Coefficient", "[", RowBox[
                         {"p", ",", "x", ",", "degree"}], "]"}], ">", 
                      "0"}]}], ",", 
                  "\"Nonpositive endpoint or leading coefficient\""}], "]"}], 
              ";", RowBox[{"chain", "=", RowBox[{"{", "p", "}"}]}], ";", 
              RowBox[{"If", "[", RowBox[{RowBox[{"degree", ">", "0"}], ",", 
                  RowBox[{RowBox[{"q", "=", RowBox[{"primitive", "[", 
                        RowBox[{RowBox[{SubscriptBox["\[PartialD]", RowBox[
                          {"x"}]], "p"}], ",", "x"}], "]"}]}], ";", 
                    RowBox[{"AppendTo", "[", RowBox[{"chain", ",", "q"}], 
                      "]"}], ";", RowBox[{"While", "[", RowBox[{"True", ",", 
                        RowBox[{RowBox[{"rem", "=", RowBox[
                          {"PolynomialRemainder", "[", RowBox[{"p", ",", "q", 
                          ",", "x"}], "]"}]}], ";", RowBox[{"If", "[", 
                          RowBox[{RowBox[{"rem", "===", "0"}], ",", RowBox[
                          {"Break", "[", "]"}]}], "]"}], ";", RowBox[{"rem", 
                          "=", RowBox[{"primitive", "[", RowBox[{RowBox[
                          {"-", "rem"}], ",", "x"}], "]"}]}], ";", RowBox[
                          {"AppendTo", "[", RowBox[{"chain", ",", "rem"}], 
                          "]"}], ";", RowBox[{"p", "=", "q"}], ";", RowBox[
                          {"q", "=", "rem"}], ";"}]}], "]"}], ";"}]}], "]"}], 
              ";", RowBox[{"v0", "=", RowBox[{"variations", "[", 
                  RowBox[{RowBox[{"(", RowBox[{RowBox[{"#1", "/.", 
                          "\[VeryThinSpace]", RowBox[{"x", "\[Rule]", 
                          "0"}]}], "&"}], ")"}], "/@", "chain"}], "]"}]}], 
              ";", RowBox[{"vi", "=", RowBox[{"variations", "[", 
                  RowBox[{RowBox[{"(", RowBox[{RowBox[{"Coefficient", "[", 
                          RowBox[{"#1", ",", "x", ",", RowBox[{"Exponent", 
                          "[", RowBox[{"#1", ",", "x"}], "]"}]}], "]"}], 
                        "&"}], ")"}], "/@", "chain"}], "]"}]}], ";", 
              RowBox[{"check", "[", RowBox[{RowBox[{"v0", "\[Equal]", "vi"}], 
                  ",", "\"Sturm chain detects a positive root\""}], "]"}], 
              ";", RowBox[{"Association", "[", RowBox[{RowBox[{"\"Degree\"", 
                    "\[Rule]", "degree"}], ",", RowBox[
                   {"\"VariationsAtZero\"", "\[Rule]", "v0"}], ",", 
                  RowBox[{"\"VariationsAtInfinity\"", "\[Rule]", "vi"}]}], 
                "]"}]}]}], "]"}]}], ";", "\[IndentingNewLine]"}]], "Input"], 
  Cell["Gram matrices and leading principal minors", "Subsection"], 
  Cell[
   "The leading principal minors are computed by a determinant recurrence.", 
   "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"gram", "[", RowBox[{"a_List", ",", 
            RowBox[{"corrected_", ":", "False"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[
           {RowBox[{"{", RowBox[{RowBox[{"n", "=", RowBox[{FractionBox["1", 
                     "2"], " ", RowBox[{"(", RowBox[{RowBox[{"Length", "[", 
                          "a", "]"}], "+", "1"}], ")"}]}]}], ",", "g", ",", 
                "j"}], "}"}], ",", RowBox[{RowBox[{"check", "[", 
                RowBox[{RowBox[{RowBox[{"IntegerQ", "[", "n", "]"}], "&&", 
                    RowBox[{"n", "\[GreaterEqual]", "3"}]}], ",", 
                  "\"Invalid Gram size\""}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"g", "=", RowBox[
                 {"ConstantArray", "[", RowBox[{"0", ",", RowBox[{"{", 
                      RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"Do", "[", RowBox[
                 {RowBox[{RowBox[{"g", "\[LeftDoubleBracket]", RowBox[
                       {"j", ",", "j"}], "\[RightDoubleBracket]"}], "=", 
                    RowBox[{"a", "\[LeftDoubleBracket]", RowBox[
                       {RowBox[{"2", " ", "j"}], "-", "1"}], 
                      "\[RightDoubleBracket]"}]}], ",", RowBox[{"{", 
                    RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", RowBox[{"Do", "[", RowBox[
                 {RowBox[{RowBox[{"g", "\[LeftDoubleBracket]", RowBox[
                       {"j", ",", RowBox[{"j", "+", "1"}]}], 
                      "\[RightDoubleBracket]"}], "=", RowBox[{RowBox[
                       {"g", "\[LeftDoubleBracket]", RowBox[{RowBox[{"j", 
                          "+", "1"}], ",", "j"}], "\[RightDoubleBracket]"}], 
                      "=", RowBox[{FractionBox["1", "2"], " ", RowBox[
                         {"a", "\[LeftDoubleBracket]", RowBox[{"2", " ", 
                          "j"}], "\[RightDoubleBracket]"}]}]}]}], ",", 
                  RowBox[{"{", RowBox[{"j", ",", RowBox[{"n", "-", "1"}]}], 
                    "}"}]}], "]"}], ";", "\[IndentingNewLine]", "  ", 
              RowBox[{"If", "[", RowBox[{"corrected", ",", RowBox[
                   {RowBox[{RowBox[{"g", "\[LeftDoubleBracket]", RowBox[
                         {"1", ",", "3"}], "\[RightDoubleBracket]"}], "=", 
                      RowBox[{RowBox[{"g", "\[LeftDoubleBracket]", RowBox[
                          {"3", ",", "1"}], "\[RightDoubleBracket]"}], "=", 
                        RowBox[{"correction", " ", RowBox[{"a", 
                          "\[LeftDoubleBracket]", "3", 
                          "\[RightDoubleBracket]"}]}]}]}], ";", 
                    "\[IndentingNewLine]", "    ", RowBox[{RowBox[{"g", 
                        "\[LeftDoubleBracket]", RowBox[{"2", ",", "2"}], 
                        "\[RightDoubleBracket]"}], "-=", RowBox[{"2", " ", 
                        "correction", " ", RowBox[{"a", 
                          "\[LeftDoubleBracket]", "3", 
                          "\[RightDoubleBracket]"}]}]}]}]}], "]"}], ";", 
              "\[IndentingNewLine]", "  ", "g"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", ""}]], "Input"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"minors", "[", RowBox[{"a_List", ",", 
            RowBox[{"corrected_", ":", "False"}]}], "]"}], ":=", 
        RowBox[{"Module", "[", RowBox[{RowBox[{"{", RowBox[{"g", ",", "h", 
                ",", "off", ",", "z", ",", "result", ",", "n"}], "}"}], ",", 
            RowBox[{RowBox[{"g", "=", RowBox[{RowBox[{"If", "[", RowBox[
