import R7.Algebra.Univariate

set_option maxRecDepth 100000
set_option maxHeartbeats 0

namespace R7.Core.Certificates.Terminal121

open Univariate

def polynomial_0 : Poly := [1]
def certificate_0 : CompactCertificate := .leaf 0 ![1]
theorem accepted_0 : checkCompactified polynomial_0 0 certificate_0 = true := by
  decide +kernel
theorem positive_0 (x : ℝ) (hx : 0 ≤ x) : 0 < evaluate polynomial_0 x :=
  checkCompactified_sound _ _ _ accepted_0 x hx

