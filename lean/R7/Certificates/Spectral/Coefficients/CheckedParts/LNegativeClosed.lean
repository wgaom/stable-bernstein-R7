theorem table_homogeneous199 : (interpretKey p199).IsHomogeneous degree199 := by
  have hh : p199.all (fun a => R7.Core.SpectralCoefficient.Kronecker.totalExp a.exp == degree199) = true := by decide +kernel
  apply R7.Core.SpectralCoefficient.Kronecker.interpret_homogeneous p199 degree199
  intro a ha
