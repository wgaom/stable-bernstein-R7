  Cell["Direct and successive Schur elimination are compared before the \
rational substitution.", "Text"], 
  Cell[BoxData[RowBox[
     {RowBox[{RowBox[{"quotient", "[", RowBox[{"n_", ",", "d_", ",", 
            "vars_List"}], "]"}], ":=", RowBox[{"Module", "[", 
          RowBox[{RowBox[{"{", RowBox[{"q", "=", RowBox[{"Cancel", "[", 
