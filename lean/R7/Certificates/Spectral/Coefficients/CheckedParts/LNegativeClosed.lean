  (R7.Algebra.Kronecker.clearLCM (R7.Core.SpectralCoefficient.Kronecker.weight base199) e199).numerator
noncomputable abbrev rhs199 := R7.Algebra.Kronecker.Expr.mul
  (.constant (R7.Algebra.Kronecker.clearLCM (R7.Core.SpectralCoefficient.Kronecker.weight base199) e199).denominator)
